            "$value": 1024,
            "scopes": []
          },
          "tablet": {
            "$type": "number",
            "$value": 768,
            "scopes": []
          }
        },
        "frame-width": {
          "$type": "number",
          "$value": 1920,
          "scopes": ["WIDTH_HEIGHT"],
          "$extensions": {
            "com.figma.modes": {
              "desktop": 1920,
              "tablet": 768,
              "mobile": 375
            }
          }
        }
      }
    }
  }
}
