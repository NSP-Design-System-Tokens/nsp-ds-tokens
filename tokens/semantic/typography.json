        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.base}",
        "lineHeight": "{font.line-height.160}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "body-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.160}",
        "letterSpacing": "{font.letter-spacing.wide}"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.xs}",
        "lineHeight": "{font.line-height.160}",
        "letterSpacing": "{font.letter-spacing.wide}"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.120}",
        "letterSpacing": "{font.letter-spacing.wide}",
        "textCase": "UPPER"
      }
    },
    "cta": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.120}",
        "letterSpacing": "{font.letter-spacing.wide}",
        "textDecoration": "UNDERLINE",
        "textCase": "UPPER"
      }
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.xs}",
        "lineHeight": "{font.line-height.120}",
        "letterSpacing": "{font.letter-spacing.wider}",
        "textCase": "UPPER"
      }
    }
