        "fontWeight": "{font.weight.light}",
        "fontSize": "{font.size.8xl}",
        "lineHeight": "{font.line-height.100}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "{font.size.6xl}",
        "lineHeight": "{font.line-height.110}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "{font.size.5xl}",
        "lineHeight": "{font.line-height.120}",
        "letterSpacing": "{font.letter-spacing.snug}"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
