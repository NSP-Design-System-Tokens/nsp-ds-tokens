{
  "type-size": {
    "$extensions": { "com.figma.scoping": ["FONT_SIZE"] },
    "display": {
      "$type": "dimension",
      "$value": "40px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "40px",
          "tablet": "72px",
          "desktop": "{font.size.8xl}"
        }
      }
    },
    "h1": {
      "$type": "dimension",
      "$value": "32px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "32px",
          "tablet": "56px",
          "desktop": "{font.size.7xl}"
        }
      }
    },
    "h2": {
      "$type": "dimension",
      "$value": "28px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "28px",
          "tablet": "48px",
          "desktop": "{font.size.6xl}"
        }
      }
    },
    "h3": {
      "$type": "dimension",
      "$value": "24px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "24px",
          "tablet": "36px",
          "desktop": "{font.size.5xl}"
        }
      }
    },
    "h4": {
      "$type": "dimension",
      "$value": "20px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "20px",
          "tablet": "28px",
          "desktop": "{font.size.4xl}"
        }
      }
    },
    "h5": {
      "$type": "dimension",
      "$value": "20px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "20px",
          "tablet": "24px",
          "desktop": "{font.size.3xl}"
        }
      }
    },
    "h6": {
      "$type": "dimension",
      "$value": "18px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "18px",
          "tablet": "20px",
          "desktop": "{font.size.2xl}"
        }
      }
    },
    "body-large": {
      "$type": "dimension",
      "$value": "18px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "18px",
          "tablet": "20px",
          "desktop": "{font.size.xl}"
        }
      }
    },
    "body": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "16px",
          "tablet": "16px",
          "desktop": "{font.size.base}"
        }
      }
    },
    "body-small": {
      "$type": "dimension",
      "$value": "14px",
      "$extensions": {
        "com.figma.modes": {
          "mobile": "14px",
          "tablet": "14px",
          "desktop": "{font.size.sm}"
        }
      }
    }
  }
}
