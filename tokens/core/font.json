{
  "font": {
    "$extensions": { "com.figma.scoping": [] },
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Montserrat"
      },
      "sans-2": {
        "$type": "fontFamily",
        "$value": "Inter"
      }
    },
    "weight": {
      "light": {
        "$type": "fontWeight",
        "$value": 300
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "line-height": {
      "100": {
        "$type": "number",
        "$value": 1.0
      },
      "110": {
        "$type": "number",
        "$value": 1.1
      },
      "120": {
        "$type": "number",
        "$value": 1.2
      },
      "125": {
        "$type": "number",
        "$value": 1.25
      },
      "130": {
        "$type": "number",
        "$value": 1.3
      },
      "135": {
        "$type": "number",
        "$value": 1.35
      },
      "140": {
        "$type": "number",
        "$value": 1.4
      },
      "145": {
        "$type": "number",
        "$value": 1.45
      },
      "150": {
        "$type": "number",
        "$value": 1.5
      },
      "155": {
        "$type": "number",
        "$value": 1.55
      },
      "160": {
        "$type": "number",
        "$value": 1.6
      }
    },
    "letter-spacing": {
      "tight": { "$type": "dimension", "$value": "-0.05em" },
      "snug": { "$type": "dimension", "$value": "-0.025em" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.025em" },
      "wider": { "$type": "dimension", "$value": "0.05em" },
      "widest": { "$type": "dimension", "$value": "0.1em" }
    },
    "size": {
      "2xs": { "$type": "dimension", "$value": "11px" },
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" },
      "4xl": { "$type": "dimension", "$value": "36px" },
      "5xl": { "$type": "dimension", "$value": "48px" },
      "6xl": { "$type": "dimension", "$value": "60px" },
      "7xl": { "$type": "dimension", "$value": "72px" },
      "8xl": { "$type": "dimension", "$value": "96px" },
      "9xl": { "$type": "dimension", "$value": "128px" }
    }
  }
}
