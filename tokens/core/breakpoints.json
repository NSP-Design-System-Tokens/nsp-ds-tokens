{
  "breakpoint": {
    "$extensions": { "com.figma.scoping": [] },
    "desktop": { "$type": "number", "$value": 1920 },
    "tablet": { "$type": "number", "$value": 768 },
    "mobile": { "$type": "number", "$value": 375 },
    "threshold": {
      "desktop": { "$type": "number", "$value": 1024 },
      "tablet": { "$type": "number", "$value": 768 }
    },
    "frame-width": {
      "$type": "number",
      "$value": 1920,
      "$extensions": {
        "com.figma.scoping": ["WIDTH_HEIGHT"],
        "com.figma.modes": {
          "desktop": 1920,
          "tablet": 768,
          "mobile": 375
        }
      }
    }
  }
}
